# ==============================================================================
# Environment Configuration Template for Vedant Exports International
# ==============================================================================
# Copy this file to .env and fill in the values for local development.
# Do NOT commit actual secrets or credentials to version control.

# --- Core Backend Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_INQUIRIES_PER_MINUTE=5

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vei_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Email Notifications (Resend) ---
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Vedant Exports <inquiries@vedantexports.com>
COMPANY_NOTIFICATION_EMAIL=vedantexportsofficial@gmail.com

# --- WhatsApp Notifications (Twilio / Meta Cloud) ---
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
COMPANY_NOTIFICATION_WHATSAPP=+919876543210

# --- Notification Resilience & Retry ---
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=2

# --- Frontend (Next.js Public Variables) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_COMPANY_WHATSAPP=919876543210
